# ==============================================================================
# Inworld AI Multilingual Realtime Chat & Floating Desktop Assistant Configuration
# ==============================================================================

# Inworld API Key (Base64-encoded credentials from https://platform.inworld.ai/ -> Settings -> API Keys)
# Example: INWORLD_API_KEY=base64EncodedKeyString
INWORLD_API_KEY=your_inworld_base64_api_key_here

# Custom Inworld Voice ID
# Default: Mukesh Sharma (zippy-kite-2028__mukesh_sharma_voice)
# Alternative: Hindi Person (zippy-kite-2028__design-voice-7eea8ae2)
INWORLD_VOICE_ID=zippy-kite-2028__mukesh_sharma_voice

# Selected Realtime LLM Model / Router
# Examples:
#  - inworld/models/deepseek-v4-flash (Fast, accurate Devanagari Hindi orthography)
#  - google-ai-studio/gemini-2.5-flash (Ultra-fast multimodal)
#  - openai/gpt-4o-mini
INWORLD_MODEL=inworld/models/deepseek-v4-flash

# Selected Inworld TTS Model
# Options:
#  - inworld-tts-2 (High quality, 200+ languages, natural prosody)
#  - inworld-tts-2-flash (Lowest latency)
INWORLD_TTS_MODEL=inworld-tts-2

# Backend WebSocket & HTTP Port
PORT=4000

# Frontend Dev Server Port (optional)
VITE_PORT=5173
